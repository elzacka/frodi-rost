# Xcode (xcodeproj is generated by xcodegen from project.yml). The one file kept
# is Package.resolved: it pins every package, WhisperKit's dependencies included,
# to the revision the app was built with. xcodegen leaves it alone.
Frodi.xcodeproj/*
!Frodi.xcodeproj/project.xcworkspace/
Frodi.xcodeproj/project.xcworkspace/*
!Frodi.xcodeproj/project.xcworkspace/xcshareddata/
Frodi.xcodeproj/project.xcworkspace/xcshareddata/*
!Frodi.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
Frodi.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/*
!Frodi.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved
build/
DerivedData/
*.xcuserdata
/*.xcworkspace
xcuserdata/

# Swift Package Manager
.build/
Packages/

# OS
.DS_Store
*.swp
*~

# IDE
.vscode/

# Knytter repoet til Apple-utviklerkontoen. Trengs lokalt for arkivering,
# men hører ikke hjemme i et offentlig repo.
ExportOptions.plist

# Developer context
.obsidian/
.claude/
dev_only/

# Assistant instructions for this repo. What a contributor needs from it is
# published in CONTRIBUTING.md; the rest imports dev_only/, which is not.
CLAUDE.md

# CoreML-modellen. Nesten en halv gigabyte, hentes av Scripts/fetch-model.sh
Frodi/Resources/Model/
